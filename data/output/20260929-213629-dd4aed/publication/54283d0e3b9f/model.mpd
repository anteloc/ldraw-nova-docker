0 FILE bradbury.ldr
0 The Bradbury Building, Broadway at 3rd Street, Los Angeles: brick corner block with a chamfered corner, round-arch arcade, glazed light court and street furniture
0 Name: bradbury.ldr
0 Author: carlos.antelo@gmail.com via LDraw Astra agent
0 !LDRAW_ORG Model
0 // site: Street, kerb and sidewalk
1 72 0 0 0 1 0 0 0 1 0 0 0 1 brad-base.ldr
0 STEP
0 // ground: Stone ground storey with shopfronts and the Broadway entrance
1 19 0 -8 0 1 0 0 0 1 0 0 0 1 brad-ground.ldr
0 // storey-1: brad-storey.ldr
1 19 0 -144 0 1 0 0 0 1 0 0 0 1 brad-storey.ldr
0 // storey-2: brad-storey.ldr
1 19 0 -256 0 1 0 0 0 1 0 0 0 1 brad-storey.ldr
0 // storey-3: brad-storey.ldr
1 19 0 -368 0 1 0 0 0 1 0 0 0 1 brad-storey.ldr
0 // arcade: Top-floor round-arch arcade
1 19 0 -480 0 1 0 0 0 1 0 0 0 1 brad-arcade.ldr
0 // roof: Roof bed, skylight and bulkhead
1 72 0 -592 0 1 0 0 0 1 0 0 0 1 brad-roof.ldr
0 // cornice: brad-cornice.ldr
1 70 0 -600 0 1 0 0 0 1 0 0 0 1 brad-cornice.ldr
0 STEP
0 // lift-a: Two open-cage elevators stand in the light court
1 0 0 -24 60 1 0 0 0 1 0 0 0 1 brad-elevator.ldr
0 // lift-b: brad-elevator.ldr
1 0 0 -24 260 1 0 0 0 1 0 0 0 1 brad-elevator.ldr
0 // stair-1: brad-stair.ldr
1 70 -140 -24 140 1 0 0 0 1 0 0 0 1 brad-stair.ldr
0 STEP
0 // escape: Fire escape on the 3rd Street elevation
1 0 200 -16 220 1 0 0 0 1 0 0 0 1 brad-fire-escape.ldr
0 STEP
0 // sign: Vertical BRADBURY BLDG sign right on the street corner
1 0 240 -8 -160 1 0 0 0 1 0 0 0 1 brad-blade-sign.ldr
0 // lamp-a: brad-lamp.ldr
1 0 280 -8 60 1 0 0 0 1 0 0 0 1 brad-lamp.ldr
0 // lamp-b: brad-lamp.ldr
1 0 -120 -8 -180 0 0 1 0 1 0 -1 0 0 brad-lamp.ldr
0 // signal: brad-signal.ldr
1 0 280 -8 -200 1 0 0 0 1 0 0 0 1 brad-signal.ldr
0 // planter-a: brad-planter.ldr
1 2 -420 -8 -180 1 0 0 0 1 0 0 0 1 brad-planter.ldr
0 // planter-b: brad-planter.ldr
1 2 260 -8 300 1 0 0 0 1 0 0 0 1 brad-planter.ldr
0 // hydrant: brad-hydrant.ldr
1 4 70 -8 -170 1 0 0 0 1 0 0 0 1 brad-hydrant.ldr
0 NOFILE
